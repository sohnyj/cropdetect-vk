+
+#pragma shader_stage(compute)
+
+#extension GL_EXT_shader_image_load_formatted : require
+#extension GL_EXT_scalar_block_layout : require
+#extension GL_EXT_nonuniform_qualifier : require
+
+layout (constant_id = 0) const uint width = 0;
+layout (constant_id = 1) const uint height = 0;
+layout (constant_id = 2) const uint shift = 0;
+
+layout (local_size_x_id = 253, local_size_y_id = 254, local_size_z_id = 255) in;
+
+layout (set = 0, binding = 0) uniform readonly uimage2D input_img[];
+layout (set = 0, binding = 1, scalar) buffer sum_buffer {
+    uint line_sum[]; /* height row sums, followed by width column sums */
+};
+
+/* one more column than the workgroup, so that the row sums read the banks
+ * of different rows */
+shared uint tile[gl_WorkGroupSize.y][gl_WorkGroupSize.x + 1];
+
+void main()
+{
+    const uvec2 pos = gl_GlobalInvocationID.xy;
+
+    /* oob invocs store 0, so that every tile entry is written before the
+     * barrier; the image may be larger than the frame, so the frame size
+     * bounds too */
+    const uvec2 size = min(uvec2(imageSize(input_img[0])), uvec2(width, height));
+    uint value = 0;
+    if (all(lessThan(pos, size)))
+        value = imageLoad(input_img[0], ivec2(pos)).x >> shift;
+    tile[gl_LocalInvocationID.y][gl_LocalInvocationID.x] = value;
+
+    barrier();
+
+    /* the first invocations sum up the columns, the next ones the rows */
+    const uvec2 origin = gl_WorkGroupID.xy * gl_WorkGroupSize.xy;
+    const uint index = gl_LocalInvocationIndex;
+    if (index < gl_WorkGroupSize.x) {
+        uint sum = 0;
+        for (uint row = 0; row < gl_WorkGroupSize.y; row++)
+            sum += tile[row][index];
+        if (origin.x + index < width)
+            atomicAdd(line_sum[height + origin.x + index], sum);
+    } else if (index < gl_WorkGroupSize.x + gl_WorkGroupSize.y) {
+        const uint row = index - gl_WorkGroupSize.x;
+        uint sum = 0;
+        for (uint column = 0; column < gl_WorkGroupSize.x; column++)
+            sum += tile[row][column];
+        if (origin.y + row < height)
+            atomicAdd(line_sum[origin.y + row], sum);
+    }
+}
