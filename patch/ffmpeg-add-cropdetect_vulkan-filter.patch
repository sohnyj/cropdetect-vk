+ * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+ */
+
+#pragma shader_stage(compute)
+
+#extension GL_EXT_shader_image_load_formatted : require
+#extension GL_EXT_scalar_block_layout : require
+#extension GL_EXT_nonuniform_qualifier : require
+#extension GL_EXT_null_initializer : require
+
+layout (constant_id = 0) const uint width = 0;
+layout (constant_id = 1) const uint height = 0;
+layout (constant_id = 2) const uint shift = 0;
+
+layout (local_size_x_id = 253, local_size_y_id = 254, local_size_z_id = 255) in;
+
+layout (set = 0, binding = 0) uniform readonly uimage2D input_img[];
+layout (set = 0, binding = 1, scalar) buffer sum_buffer {
+    uint line_sum[]; /* height row sums, followed by width column sums */
+};
+
+shared uint wg_row_sum[gl_WorkGroupSize.y] = { };
+shared uint wg_col_sum[gl_WorkGroupSize.x] = { };
+
+void main()
+{
+    const uvec2 pos = gl_GlobalInvocationID.xy;
+
+    /* oob invocs still must reach the barrier, but mustn't get summed up;
+     * the image may be larger than the frame, so the frame size bounds too */
+    const uvec2 size = min(uvec2(imageSize(input_img[0])), uvec2(width, height));
+    if (all(lessThan(pos, size))) {
+        uint value = imageLoad(input_img[0], ivec2(pos)).x >> shift;
+        atomicAdd(wg_row_sum[gl_LocalInvocationID.y], value);
+        atomicAdd(wg_col_sum[gl_LocalInvocationID.x], value);
+    }
+
+    barrier();
+    if (gl_LocalInvocationID.x == 0 && pos.y < height)
+        atomicAdd(line_sum[pos.y], wg_row_sum[gl_LocalInvocationID.y]);
+    if (gl_LocalInvocationID.y == 0 && pos.x < width)
+        atomicAdd(line_sum[height + pos.x], wg_col_sum[gl_LocalInvocationID.x]);
+}
